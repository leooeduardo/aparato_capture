{
    "name": "lumina-mapper",
    "private": true,
    "version": "1.0.0",
    "main": "electron/main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "osc": "node server/osc-bridge.js",
        "bridge": "node bridge/index.js",
        "start": "concurrently \"npm run dev\" \"npm run bridge\" \"npm run osc\"",
        "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "npm run build && electron-builder"
    },
    "build": {
        "appId": "com.lumina.mapper",
        "productName": "Lumina Mapper",
        "win": {
            "target": "nsis"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "server/**/*",
            "bridge/**/*",
            "package.json"
        ],
        "directories": {
            "buildResources": "assets"
        }
    },
    "dependencies": {
        "@types/three": "^0.182.0",
        "clsx": "^2.1.0",
        "electron-is-dev": "^3.0.1",
        "framer-motion": "^10.16.4",
        "lucide-react": "^0.300.0",
        "node-osc": "^11.2.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "serialport": "^13.0.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^2.2.1",
        "three": "^0.182.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^40.1.0",
        "electron-builder": "^26.7.0",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.2.2",
        "vite": "^5.0.8",
        "wait-on": "^9.0.3"
    }
}